<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7EC">


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- BACK ARROW -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#161414"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingEnd="8dp"/>

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wallet &amp; Payments"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E6F43"
            android:layout_marginBottom="20dp"/>



        <!-- BALANCE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#1E6F43"
            android:layout_marginBottom="20dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available Balance"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rs. 0.00"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VISA  •••• 4587"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

        <!-- CARD DETAILS -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Card Details"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1E6F43"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etCardNumber"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Card Number"
            android:inputType="number"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etCardName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Card Holder Name"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etExpiry"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="MM/YY"
                android:background="@android:color/white"
                android:padding="12dp"
                android:layout_marginEnd="8dp"/>

            <EditText
                android:id="@+id/etCVV"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_weight="1"
                android:hint="CVV"
                android:inputType="numberPassword"
                android:background="@android:color/white"
                android:padding="12dp"/>
        </LinearLayout>

        <!-- ADD MONEY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Money"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1E6F43"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter amount (Rs)"
            android:inputType="number"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnAddMoney"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Pay with Visa / MasterCard"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1E6F43"
            android:layout_marginBottom="20dp"/>

        <!-- WITHDRAW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Withdraw Money"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#1E6F43"
            android:layout_marginBottom="10dp"/>


        <EditText
            android:id="@+id/etWithdraw"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter withdraw amount"
            android:inputType="number"
            android:background="@android:color/white"
            android:padding="12dp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnWithdraw"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Withdraw"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#FF5722"/>
        <Button
            android:id="@+id/btnHistory"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Transaction History"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#1E6F43"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</ScrollView>